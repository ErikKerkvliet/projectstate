[Unit]
Description=projectstate MCP server + dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcpstate
Group=mcpstate
WorkingDirectory=/opt/projectstate/app
EnvironmentFile=/opt/projectstate/app/.env
ExecStart=/opt/projectstate/venv/bin/uvicorn projectstate.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --log-level info
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/projectstate/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=600M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
