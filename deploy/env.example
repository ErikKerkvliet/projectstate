# /opt/projectstate/app/.env  (chmod 600, owner mcpstate). Restart after changes: systemctl restart projectstate
BASE_URL=https://93.127.138.101
DB_PATH=/opt/projectstate/data/projectstate.db
BACKUP_DIR=/var/backups/projectstate
SECRET_KEY=change-me
LOG_LEVEL=INFO

# Dashboard admin (hash with: /opt/projectstate/venv/bin/python scripts/admin_password.py 'new-password')
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Payments: x402 only (no accounts, no card rail).
# off | mock (local mock facilitator) | testnet (Base Sepolia via https://x402.org/facilitator) | live (Base mainnet via CDP)
X402_MODE=testnet
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
X402_PAY_TO=
# live only: Coinbase Developer Platform keys (Ed25519); cdp-sdk is installed in the venv
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# defaults seeded once into the settings table; afterwards edit them in the dashboard
PRICE_PROJECT_OPEN=0.002
PRICE_PROJECT_STATUS=0.002
PRICE_REMEMBER=0.002
PRICE_RECALL=0.005
PRICE_UPDATE=0.002
DEFAULT_DAILY_CALL_CAP=2000
DEFAULT_DAILY_SPEND_CAP_USD=5.00
DEFAULT_PER_MINUTE_CAP=60
X402_PACK_USD=0.10
X402_MIN_PAYMENT_USD=0.01
MONTHLY_COST_USD=6.00
ALARM_CALLS_PER_HOUR=300
